# Variables de Entorno para Firebase (Opcional para conectar base de datos en tiempo real en la nube)
# Puedes obtener estos valores en la consola de Firebase (https://console.firebase.google.com/)
# Crea un proyecto Firebase, activa Authentication (Email y Google) y Firestore Database.

VITE_FIREBASE_API_KEY=tu_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_project_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
